+        llama_block_routing_params res;
+
+        const char * env = getenv("LLAMA_BLOCK_ROUTING");
+        if (env == nullptr || env[0] == '\0') {
+            return res;
+        }
+
+        int block = 0;
+        int pool  = 0;
+        if (sscanf(env, "%d:%d", &block, &pool) != 2 || block <= 0 || pool <= 0) {
+            LLAMA_LOG_WARN("llama_block_routing_get: ignoring LLAMA_BLOCK_ROUTING='%s', expected <block>:<pool> with both > 0\n", env);
+            return res;
+        }
+
+        res.block = block;
+        res.pool  = pool;
+
+        LLAMA_LOG_INFO("llama_block_routing_get: LLAMA_BLOCK_ROUTING: block = %d tokens, pool = %d experts\n", block, pool);
+
+        return res;
+    }();
+
+    return params;
