 #include <algorithm>
 #include <sstream>
 
+// LLAMA_ALLOW_NONCONSECUTIVE_POS=1 lets a batch's positions skip ahead of, or fall below, the
+// last position the memory module holds for its sequence, and leave gaps inside the batch.
+// Diffusion LM drivers (WeDLM) write rows out of logical order, one row per decode with
+// non-causal attention, and remove them again with llama_memory_seq_rm. Read once.
+static bool llama_allow_nonconsecutive_pos() {
+    static const bool allow = [] {
+        const char * env = getenv("LLAMA_ALLOW_NONCONSECUTIVE_POS");
+        return env != nullptr && atoi(env) != 0;
+    }();
+    return allow;
+}
+
 llama_batch_allocr::llama_batch_allocr(uint32_t n_pos_per_embd) : n_pos_per_embd(n_pos_per_embd) {
     const char * LLAMA_BATCH_DEBUG = getenv("LLAMA_BATCH_DEBUG");
     debug = LLAMA_BATCH_DEBUG ? atoi(LLAMA_BATCH_DEBUG) : 0;
@@ -287,6 +299,8 @@ bool llama_batch_allocr::init(
             }
         }
     } else {
+        const bool allow_noncons = llama_allow_nonconsecutive_pos();
+
