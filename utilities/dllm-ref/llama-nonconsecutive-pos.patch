             if (seq_pos[s].empty()) {
                 continue;
@@ -294,7 +308,7 @@ bool llama_batch_allocr::init(
 
             const llama_pos p0 = memory ? memory->seq_pos_max(s) : -1;
 
-            if (p0 >= 0) {
+            if (p0 >= 0 && !allow_noncons) {
                 bool ok = true;
 
                 if (seq_pos_min(s) != p0 + 1) {
@@ -313,7 +327,7 @@ bool llama_batch_allocr::init(
